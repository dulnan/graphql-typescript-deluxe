{
  "name": "graphql-typescript-deluxe",
  "version": "0.1.0",
  "description": "Fast GraphQL TypeScript code generator",
  "sideEffects": false,
  "author": "Jan Hug <me@dulnan.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dulnan/graphql-typescript-deluxe.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./*": "./*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@graphql-codegen/core": "^5.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.6",
    "@graphql-tools/load": "^8.1.7",
    "@types/node": "^25.0.2",
    "@vitest/coverage-v8": "~4.0",
    "chokidar": "^5.0.0",
    "glob": "^13.0.0",
    "knip": "^5.73.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "~5.9",
    "unbuild": "^3.6.1",
    "vitest": "~4.0"
  },
  "scripts": {
    "build": "unbuild",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run unit --config __tests__/vitest.config.ts",
    "test:coverage": "vitest run unit --config __tests__/vitest.config.ts --coverage.enabled --coverage.all --coverage.reporter=json --coverage.reporter=text",
    "test:coverage:report": "npm run test:coverage && node ./scripts/coverage-report.cjs",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "tsc",
    "test:watch": "WATCH_MODE=true vitest unit --config __tests__/vitest.config.ts",
    "benchmark": "node --expose-gc ./benchmark/index.cjs",
    "examples:watcher": "node ./examples/watcher/index.mjs",
    "debug-test-case": "node ./examples/debug-test-case/index.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "graphql": "^16.12.0"
  }
}
